{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditProposal",
  "type": "object",
  "properties": {
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "UNRESOLVED"]
          }
        },
        "required": ["metric_id", "status"]
      }
    }
  },
  "required": ["metrics"]
}
